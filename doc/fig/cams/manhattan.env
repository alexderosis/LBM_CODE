# Cameras for the Midtown Manhattan run: 400 x 400 x 100 at 5 m, so a
# 2000 x 2000 x 500 m box -- 200 m taller than the Manchester one these
# defaults were tuned for, with buildings to 472 m.
#
# ALL THREE SHARE ONE AZIMUTH, and that is the point. The wind blows toward
# 28 deg, which is the axis the street grid was MEASURED to run along (marching
# rays through the height field gives two orthogonal corridor directions, 28 and
# 118 deg -- the Commissioners' Plan, recovered from the geometry rather than
# assumed). Placing every camera perpendicular to that axis puts the plume
# travelling left-to-right in every panel, so the three read as one event seen
# three ways instead of three unrelated pictures.
#
# -fov is the VERTICAL angle; horizontal follows from the panel aspect. That is
# what sets the distances below: a panel 420 px tall showing 500 m of city wants
# tan(fov/2) * distance ~ 350 m, not the 800 m the Manchester distances give.

# skyline sweep, 1160 x 940 -- the whole 2 km, broadside to the plume
CAM_H=3293.3,-221.9,1086.3
FOC_H=997.5,997.5,140
FOV_H=32

# low oblique, 750 x 420 -- cropped to the first 1.2 km, camera at 475 m so the
# buildings fill the frame and the plume is seen BETWEEN them rather than above
CAM_E=1705.3,71.1,475
FOC_E=734,587,180
FOV_E=34

# plan view, 750 x 510 -- the whole box from 4.0 km up, same azimuth again
CAM_G=1530.2,714.8,4060
FOC_G=997.5,997.5,60
FOV_G=30
