# Cameras for the coupled unsteady crop: 200 x 150 x 60 at 5 m, so a
# 1000 x 750 x 300 m box. The Manchester and Manhattan presets are both framed
# for a 2 km footprint and put this one in the middle of a lot of empty ground.
#
# The wind runs along +x, so every camera sits on the -y side looking back:
# screen-right = (fwd_y, -fwd_x) is then (+1,0,0), which puts the plume
# travelling left-to-right in all three panels. -fov is the VERTICAL angle and
# the horizontal follows from each panel's aspect, which is what sets the
# distances -- a 300 m box in a 940 px panel wants tan(fov/2)*distance ~ 450 m,
# not the ~800 m the 2 km presets give.

# skyline sweep, 1160 x 940 -- the whole 1 km, broadside to the plume
CAM_H=497.5,-1077.5,700
FOC_H=497.5,372.5,90
FOV_H=32

# low oblique, 750 x 420 -- the first ~700 m, camera at 280 m so the buildings
# fill the frame and the plume is seen threading BETWEEN them
CAM_E=350,-182.5,280
FOC_E=350,437.5,110
FOV_E=34

# plan view, 750 x 510 -- the whole box from 1.5 km up, same azimuth again.
# This is the panel where the unsteady wakes show as filaments rather than as
# the smooth cone a frozen field produces.
CAM_G=497.5,172.5,1500
FOC_G=497.5,372.5,40
FOV_G=30
